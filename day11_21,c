/* Q21: Write a program to display the month name and number of days using switch-case for a given month number. */
#include <stdio.h>

// Modular function mapping month indices to a static lookup table
void print_month_details(int month) {
    const char *months[] = {"", "January", "February", "March", "April", "May", "June", 
                            "July", "August", "September", "October", "November", "December"};
    
    switch (month) {
        case 2:
            printf("%s, 28/29 days\n", months[month]);
            break;
        case 1: case 3: case 5: case 7: case 8: case 10: case 12:
            printf("%s, 31 days\n", months[month]);
            break;
        case 4: case 6: case 9: case 11:
            printf("%s, 30 days\n", months[month]);
            break;
        default:
            printf("Invalid month input.\n");
    }
}

int main() {
    int month;
    // Strict input validation
    if (scanf("%d", &month) == 1) {
        print_month_details(month);
    }
    return 0;
}